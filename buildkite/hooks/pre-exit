#!/bin/bash
echo "--- pre-exit hook fired"
echo "BUILDKITE_COMMAND_EXIT_STATUS=$BUILDKITE_COMMAND_EXIT_STATUS"
echo "BUILDKITE_JOB_LOG_TMPFILE=$BUILDKITE_JOB_LOG_TMPFILE"
echo "BUILDKITE_ORGANIZATION_SLUG=$BUILDKITE_ORGANIZATION_SLUG"
echo "BUILDKITE_PIPELINE_SLUG=$BUILDKITE_PIPELINE_SLUG"
echo "BUILDKITE_BUILD_NUMBER=$BUILDKITE_BUILD_NUMBER"
echo "BUILDKITE_JOB_ID=$BUILDKITE_JOB_ID"
echo "BUILDKITE_AGENT_ID=$BUILDKITE_AGENT_ID"

if [ -f "$BUILDKITE_JOB_LOG_TMPFILE" ]; then
  echo "--- Checking job log for known hardware errors"
  if grep -q "ERROR: failed to register layer" "$BUILDKITE_JOB_LOG_TMPFILE"; then
    echo "Flaky hardware pattern detected"

    echo "--- Annotating build"
    buildkite-agent annotate "⚠️ **Flaky hardware detected** on agent \`$BUILDKITE_AGENT_NAME\` — job failed with: \`ERROR: failed to register layer\`" \
      --style warning \
      --context flaky-hardware

    echo "--- Retrying job"
    curl -s -X PUT \
      -H "Authorization: Bearer $BUILDKITE_API_TOKEN" \
      "https://api.buildkite.com/v2/organizations/$BUILDKITE_ORGANIZATION_SLUG/pipelines/$BUILDKITE_PIPELINE_SLUG/builds/$BUILDKITE_BUILD_NUMBER/jobs/$BUILDKITE_JOB_ID/retry"

    echo "--- Taking agent offline"
    curl -s -X PUT \
      -H "Authorization: Bearer $BUILDKITE_API_TOKEN" \
      -H "Content-Type: application/json" \
      --data '{"force": false}' \
      "https://api.buildkite.com/v2/organizations/$BUILDKITE_ORGANIZATION_SLUG/agents/$BUILDKITE_AGENT_ID/stop"

    echo "--- Done"
  else
    echo "No known hardware error patterns found in log"
  fi
else
  echo "BUILDKITE_JOB_LOG_TMPFILE not set or file missing — ensure enable-job-log-tmpfile=true in agent config"
fi
