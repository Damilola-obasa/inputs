#!/bin/bash
echo "--- pre-exit hook fired"
echo "BUILDKITE_COMMAND_EXIT_STATUS=$BUILDKITE_COMMAND_EXIT_STATUS"
echo "BUILDKITE_JOB_LOG_TMPFILE=$BUILDKITE_JOB_LOG_TMPFILE"

if [ -f "$BUILDKITE_JOB_LOG_TMPFILE" ]; then
  echo "--- Checking job log for known hardware errors"
  if grep -q "ERROR: failed to register layer" "$BUILDKITE_JOB_LOG_TMPFILE"; then
    echo "Flaky hardware pattern detected — annotating build"
    buildkite-agent annotate "⚠️ **Flaky hardware detected** on agent \`$BUILDKITE_AGENT_NAME\` — job failed with: \`ERROR: failed to register layer\`" \
      --style warning \
      --context flaky-hardware
  else
    echo "No known hardware error patterns found in log"
  fi
else
  echo "BUILDKITE_JOB_LOG_TMPFILE not set or file missing — ensure enable-job-log-tmpfile=true in agent config"
fi
