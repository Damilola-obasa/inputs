#!/bin/bash

# Store the exit code from checkout
CHECKOUT_EXIT_CODE=$?

# Check if checkout failed
if [ $CHECKOUT_EXIT_CODE -ne 0 ]; then
    echo "❌ Checkout failed with exit code: $CHECKOUT_EXIT_CODE"
    echo "Running git status for debugging..."
    
    # Run git status to see what's wrong
    git status || echo "git status also failed"
    
    # Additional debugging info
    echo "--- Git repository state ---"
    git branch -a 2>/dev/null || echo "Cannot list branches"
    git remote -v 2>/dev/null || echo "Cannot list remotes"
    git log --oneline -5 2>/dev/null || echo "Cannot show recent commits"
    
    # Show working directory
    echo "--- Working directory ---"
    ls -la 2>/dev/null || echo "Cannot list directory contents"
    
    exit 1  # Ensure build fails
fi

echo "✅ Checkout successful"